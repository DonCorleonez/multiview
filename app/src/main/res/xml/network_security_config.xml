<?xml version="1.0" encoding="utf-8"?>
<!-- Most Xtream panels serve plain http; allow cleartext app-wide (§3). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
